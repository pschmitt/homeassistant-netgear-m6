{
  "config": {
    "step": {
      "user": {
        "title": "Connect to a Nighthawk M6",
        "description": "Enter the address and admin password of your Netgear Nighthawk M6.",
        "data": {
          "host": "Host",
          "password": "Admin password",
          "save_offline": "Save anyway (device is offline)"
        },
        "data_description": {
          "host": "Hostname or IP address of the device's web interface.",
          "password": "The password you use to log in to the device's web interface.",
          "save_offline": "Create the entry without reaching the device. The password cannot be checked, and the integration connects once the device is online."
        }
      },
      "reauth_confirm": {
        "title": "Re-authenticate Nighthawk M6",
        "description": "The Nighthawk M6 at {host} rejected the stored admin password. Enter the current one.",
        "data": {
          "password": "Admin password"
        }
      },
      "reconfigure": {
        "title": "Reconfigure Nighthawk M6",
        "description": "Change the address or admin password of this Nighthawk M6.",
        "data": {
          "host": "Host",
          "password": "Admin password"
        }
      }
    },
    "error": {
      "invalid_auth": "Login was rejected. Check the admin password.",
      "cannot_connect": "Could not reach the device at that host."
    },
    "abort": {
      "already_configured": "This device is already configured.",
      "reauth_successful": "Re-authentication was successful.",
      "reconfigure_successful": "Reconfiguration was successful.",
      "wrong_device": "That address belongs to a different device than the one being reconfigured."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "Nighthawk M6 options",
        "data": {
          "scan_interval": "Polling interval (seconds)"
        },
        "data_description": {
          "scan_interval": "The device allows a single admin session. Polling less often reduces how often an open web interface gets logged out."
        }
      }
    }
  },
